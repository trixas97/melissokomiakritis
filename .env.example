# Copy to .env and fill in. Never commit real values.

# PostgreSQL connection string
# Local dev (after `docker compose up postgres`): postgresql://payload:<POSTGRES_PASSWORD>@localhost:<POSTGRES_PORT>/frankbees
# In docker-compose the app builds this itself from POSTGRES_PASSWORD
DATABASE_URL=postgresql://payload:changeme@localhost:5432/frankbees
POSTGRES_PASSWORD=changeme
# Host port for the Postgres container — change it if 5432 is taken by a local Postgres
POSTGRES_PORT=5432

# Signs Payload admin session tokens — long random string (e.g. `openssl rand -hex 32`)
PAYLOAD_SECRET=

# Cloudflare R2 (S3-compatible) for media uploads.
# Use a bucket of its own (not labo's), so a deletion in one admin can't remove the other's files.
# Leave S3_BUCKET empty to store uploads on disk in ./media instead.
# After setting these, restart the dev server (next.config.ts reads S3_PUBLIC_URL at start).
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=
S3_REGION=auto
# Public base URL media is served from (R2 custom domain or r2.dev URL), no trailing slash
S3_PUBLIC_URL=

# Resend — order notification and confirmation emails
RESEND_API_KEY=
OWNER_EMAIL=
