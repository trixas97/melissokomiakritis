# Environment variables. Never commit real values.
#
# LOCAL DEVELOPMENT: copy to .env in the repo root.
# SERVER: copy to .env in each stack directory
#   /home/trixas/melissokomiakritis/prod   (production)
#   /home/trixas/melissokomiakritis/uat    (UAT)
# All server values are read at RUNTIME — restart the stack after changing them.

# ── Database ────────────────────────────────────────────────────────────────
# Local dev (after `docker compose up -d postgres`):
#   postgresql://payload:<POSTGRES_PASSWORD>@localhost:<POSTGRES_PORT>/frankbees
# On the server this is ignored — docker-compose.yml builds the URL itself.
DATABASE_URL=postgresql://payload:changeme@localhost:5432/frankbees
# Long random string, different per environment (e.g. `openssl rand -hex 24`)
POSTGRES_PASSWORD=changeme
# LOCAL ONLY — host port for the Postgres container (5433 if a native Postgres uses 5432)
POSTGRES_PORT=5432

# ── Payload ─────────────────────────────────────────────────────────────────
# Signs admin session tokens — long random string, different per environment
# (e.g. `openssl rand -hex 32`). Changing it logs everyone out.
PAYLOAD_SECRET=

# ── Cloudflare R2 (media uploads) ───────────────────────────────────────────
# Each environment uses a bucket of its OWN (production, UAT and local dev) —
# never share one: a deletion in one admin would remove the other's files.
# The bucket needs public access; S3_PUBLIC_URL is its public r2.dev URL
# (no trailing slash). A custom domain must also be added in next.config.ts.
# Leave S3_BUCKET empty locally to store uploads on disk in ./media instead.
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=
S3_REGION=auto
S3_PUBLIC_URL=

# ── Email (Resend) ──────────────────────────────────────────────────────────
RESEND_API_KEY=
OWNER_EMAIL=

# ── Site URL and indexing ───────────────────────────────────────────────────
# Public URL of this deployment — used for canonical URLs, robots.txt and
# sitemap.xml. No trailing slash needed (one is stripped if present).
# Development: http://localhost:3000
# UAT:         https://melissokomiakritis.app.trixas-lab.com
# Production:  https://melissokomiakritis.gr (also the fallback when unset)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Which environment this container is. ONLY the literal value "production"
# allows search engines to index the site — anything else (or unset) serves
# robots.txt "Disallow: /", a noindex tag and an X-Robots-Tag header.
# Production sets this in docker-compose.prod.yml, not here.
# SITE_ENV=uat

# ── Server stacks only ──────────────────────────────────────────────────────
# Host port this stack binds, for Nginx Proxy Manager to point at.
# (labo uses 3000/3001 and gtrichakis 3002/3003 on the same server.)
# Production: 3004 (the default)   UAT: 3005
# APP_PORT=3004

# Interface the port binds to.
#   127.0.0.1 (default) — only a reverse proxy on the host itself can reach it
#   0.0.0.0             — reachable from other containers and from the internet
# Nginx Proxy Manager runs as a CONTAINER addressing backends as
# http://<public-ip>:<port>, which cannot reach the host's loopback — so both
# stacks need 0.0.0.0. This publishes the app directly on APP_PORT, bypassing
# nginx and SSL: restrict the port in the Hetzner cloud firewall, since Docker's
# rules bypass ufw.
# APP_BIND=0.0.0.0

# PRODUCTION STACK ONLY — the image tag production is pinned to. Managed by the
# "Promote to Production" workflow; you should not normally edit it by hand.
# UAT ignores this and tracks :latest.
# APP_IMAGE_TAG=
